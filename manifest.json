{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Dual Subs",
  "version": "1.2.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.netflix.com/*",
    "*://*.primevideo.com/*",
    "*://*.disneyplus.com/*",
    "*://www.amazon.com/*gp/video/*",
    "*://www.amazon.co.uk/*gp/video/*",
    "*://www.amazon.de/*gp/video/*",
    "*://www.amazon.it/*gp/video/*",
    "*://www.amazon.fr/*gp/video/*",
    "*://www.amazon.es/*gp/video/*",
    "*://www.amazon.co.jp/*gp/video/*",
    "*://www.amazon.ca/*gp/video/*",
    "*://www.amazon.com.au/*gp/video/*",
    "*://www.amazon.com.br/*gp/video/*",
    "*://www.amazon.com.mx/*gp/video/*",
    "*://www.amazon.in/*gp/video/*",
    "*://www.amazon.nl/*gp/video/*",
    "*://www.amazon.se/*gp/video/*",
    "*://www.amazon.pl/*gp/video/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.netflix.com/*",
        "*://*.primevideo.com/*",
        "*://*.disneyplus.com/*",
        "*://www.amazon.com/*gp/video/*",
        "*://www.amazon.co.uk/*gp/video/*",
        "*://www.amazon.de/*gp/video/*",
        "*://www.amazon.it/*gp/video/*",
        "*://www.amazon.fr/*gp/video/*",
        "*://www.amazon.es/*gp/video/*",
        "*://www.amazon.co.jp/*gp/video/*",
        "*://www.amazon.ca/*gp/video/*",
        "*://www.amazon.com.au/*gp/video/*",
        "*://www.amazon.com.br/*gp/video/*",
        "*://www.amazon.com.mx/*gp/video/*",
        "*://www.amazon.in/*gp/video/*",
        "*://www.amazon.nl/*gp/video/*",
        "*://www.amazon.se/*gp/video/*",
        "*://www.amazon.pl/*gp/video/*"
      ],
      "js": [
        "vtt-parser.js",
        "ttml-parser.js",
        "hls.js",
        "tracks.js",
        "platforms/netflix.js",
        "platforms/prime.js",
        "platforms/disney.js",
        "overlay.js",
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.netflix.com/*",
        "*://*.primevideo.com/*",
        "*://*.disneyplus.com/*",
        "*://www.amazon.com/*gp/video/*",
        "*://www.amazon.co.uk/*gp/video/*",
        "*://www.amazon.de/*gp/video/*",
        "*://www.amazon.it/*gp/video/*",
        "*://www.amazon.fr/*gp/video/*",
        "*://www.amazon.es/*gp/video/*",
        "*://www.amazon.co.jp/*gp/video/*",
        "*://www.amazon.ca/*gp/video/*",
        "*://www.amazon.com.au/*gp/video/*",
        "*://www.amazon.com.br/*gp/video/*",
        "*://www.amazon.com.mx/*gp/video/*",
        "*://www.amazon.in/*gp/video/*",
        "*://www.amazon.nl/*gp/video/*",
        "*://www.amazon.se/*gp/video/*",
        "*://www.amazon.pl/*gp/video/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_start"
    }
  ]
}
